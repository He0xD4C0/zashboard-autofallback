#!/usr/bin/env python3
"""Control the Panel manager over the container-local API."""

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request

from panel.manager import PUBLIC, TASKS
from panel.runtime import MANAGER_PORT


def request(path, body=None):
    headers = {"Authorization": "Bearer " + os.environ["MIHOMO_SECRET"], "Content-Type": "application/json"}
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(f"http://127.0.0.1:{MANAGER_PORT}{path}", data=data, headers=headers)
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(req, timeout=8) as response:
            return json.load(response)
    except urllib.error.HTTPError as exc:
        raise RuntimeError(json.load(exc).get("error", str(exc))) from None


def main():
    parser = argparse.ArgumentParser(description="Manage the Mihomo core in Panel")
    commands = parser.add_subparsers(dest="action", required=True)
    for name in sorted(PUBLIC | TASKS | {"status"}):
        command = commands.add_parser(name)
        if name == "upgrade":
            command.add_argument("version", help="official release tag, e.g. v1.19.33")
        if name == "rules":
            command.add_argument("url", help="public HTTPS URL of a Clash ruleset YAML")
        if name == "refresh":
            command.add_argument("--skip-score", action="store_true", help="refresh subscriptions and rules only")
    args = parser.parse_args()
    path = "/autofallback/core"
    try:
        if args.action == "status":
            print(json.dumps(request(path), indent=2, ensure_ascii=False))
            return 0
        payload = {"action": args.action}
        if args.action == "upgrade":
            payload["version"] = args.version
        if args.action == "rules":
            payload["url"] = args.url
        if args.action == "refresh":
            payload["skipScore"] = args.skip_score
        job = request("/internal/tasks" if args.action in TASKS else path, payload)["job"]
        while True:
            state = request(f"{path}?job={job}")
            if state["job"]["status"] != "running":
                print(json.dumps(state, indent=2, ensure_ascii=False))
                return int(state["job"]["status"] != "ok")
            time.sleep(1)
    except (RuntimeError, OSError) as exc:
        print(f"panelctl: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
